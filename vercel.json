{
  "version": 2,
  "routes": [
    {
      "src": "/",
      "dest": "/landingpage.html"
    },
    {
      "src": "/ueber",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
